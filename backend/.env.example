# Copy to .env and fill in. Never commit .env.

# development | production | test. "development" enables Swagger at /api-docs,
# the JWT secret fallback, and the Twilio/ABR dev fallbacks below.
NODE_ENV=development
PORT=3229

# Local Mongo for development. Double-check this before running any seed
# script — seeds write to whatever database this points at.
MONGODB_URI=mongodb://localhost:27017/babylon-nexus
# Separate database for the Jest suite (it is wiped between tests).
MONGODB_TEST_URI=mongodb://localhost:27017/babylon-nexus-test

# Signs access tokens. Required outside development/test — the server refuses
# to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_DAYS=1

# Comma-separated browser origins allowed by CORS (Expo web, admin console).
# Native apps send no Origin and don't need listing. localhost is always
# allowed outside production.
CORS_ORIGINS=

# Email goes through AWS SES. EMAIL_USER is the verified sender address.
# Credentials come from the standard AWS chain (env vars, ~/.aws, or the EC2
# instance role in production).
EMAIL_USER=
AWS_REGION=ap-southeast-2

# ABN Lookup web services GUID (https://abr.business.gov.au/Tools/WebServices).
# Leave empty locally: /abr/search then returns sample businesses and
# /abr/lookup returns 503.
ABR_GUID=

# Twilio Verify for mobile OTP. Leave empty locally: in development OTPs are
# skipped and any code is accepted.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SID=

# Used by `npm run seed:admin` to create the first admin account.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
